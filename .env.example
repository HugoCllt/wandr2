# Database
DATABASE_URL=

# Admin / ingestion
ADMIN_TOKEN=

# Seed user (run `pnpm db:seed`)
SEED_USER_EMAIL=
SEED_USER_NAME=
SEED_USER_PASSWORD=

# Better Auth — generate a secret with `openssl rand -base64 32`
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
NEXT_PUBLIC_BETTER_AUTH_URL=http://localhost:3000

# Google OAuth (optional — leave empty to disable Google sign-in)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Chat LLM (Gemma) — provider is `ollama` (default) or `openrouter`.
# Both speak the OpenAI-compatible API; one ChatOpenAI binding, two base URLs.
# CHAT_LLM_PROVIDER=ollama
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_MODEL=gemma3:12b
# OPENROUTER_API_KEY=
# OPENROUTER_MODEL=google/gemma-3-12b-it
# CHAT_MONTHLY_TOKEN_CAP=100000
