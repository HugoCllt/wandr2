{"nodes": [{"id": "arch_language", "label": "Architecture Vocabulary (LANGUAGE.md)", "file_type": "document", "source_file": ".claude/skills/improve-codebase-architecture/LANGUAGE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "concept_module_depth", "label": "Module Depth Concept (Ousterhout-style)", "file_type": "rationale", "source_file": ".claude/skills/improve-codebase-architecture/LANGUAGE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Depth = leverage at the interface: large behaviour behind a small interface. Deep modules reduce cognitive cost for callers and concentrate bugs for maintainers (locality)."}, {"id": "concept_seam", "label": "Seam Concept (from Michael Feathers)", "file_type": "rationale", "source_file": ".claude/skills/improve-codebase-architecture/LANGUAGE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A seam is where a module's interface lives \u2014 where behaviour can be altered without editing in that place. One adapter = hypothetical seam; two adapters = real seam."}], "edges": [{"source": "arch_language", "target": "concept_module_depth", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".claude/skills/improve-codebase-architecture/LANGUAGE.md", "source_location": null, "weight": 1.0}, {"source": "arch_language", "target": "concept_seam", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".claude/skills/improve-codebase-architecture/LANGUAGE.md", "source_location": null, "weight": 1.0}], "hyperedges": []}