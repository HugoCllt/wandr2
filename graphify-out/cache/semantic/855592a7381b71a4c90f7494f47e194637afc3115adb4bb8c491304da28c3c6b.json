{"nodes": [{"id": "designupload_wandr_home_desktop_mockup", "label": "Wandr Home Page \u2014 Desktop Web Mockup", "file_type": "image", "source_file": "wandr_design/uploads/3F4BD718-3F2D-4350-A03F-3EFE84EA512E.png", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Full-page desktop mockup of the Wandr home screen showing the complete layout: top navigation bar, left sidebar with filters/categories, main content area with featured hero banner, map section, recommended activities grid, and a bottom CTA strip. Demonstrates how all major UI regions compose together into the Home preset experience."}, {"id": "designupload_top_navigation_bar", "label": "Top Navigation Bar", "file_type": "image", "source_file": "wandr_design/uploads/3F4BD718-3F2D-4350-A03F-3EFE84EA512E.png", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Horizontal nav at the top containing the Wandr logo (wandr+), a global search bar with placeholder 'Search activities, places, sports, vibes...', and right-side nav links: Home (active), Sport, Chat, Profile with avatar."}, {"id": "designupload_wandr_logo", "label": "Wandr Logo (wandr+)", "file_type": "image", "source_file": "wandr_design/uploads/3F4BD718-3F2D-4350-A03F-3EFE84EA512E.png", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Brand logo 'wandr' with a plus/cross icon, top-left of the nav bar."}, {"id": "designupload_global_search_bar", "label": "Global Search Bar", "file_type": "image", "source_file": "wandr_design/uploads/3F4BD718-3F2D-4350-A03F-3EFE84EA512E.png", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Search input in the top nav with placeholder text 'Search activities, places, sports, vibes...' \u2014 central discovery entry point."}, {"id": "designupload_nav_links", "label": "Top Nav Links (Home, Sport, Chat, Profile)", "file_type": "image", "source_file": "wandr_design/uploads/3F4BD718-3F2D-4350-A03F-3EFE84EA512E.png", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Right side of top nav: Home (active/highlighted), Sport, Chat, Profile with user avatar. These are the primary page preset tabs."}, {"id": "designupload_left_sidebar", "label": "Left Sidebar \u2014 Explore Filters & Categories", "file_type": "image", "source_file": "wandr_design/uploads/3F4BD718-3F2D-4350-A03F-3EFE84EA512E.png", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Vertical left sidebar with EXPLORE section (For You, Trending Now, This Weekend, New & Notable, Hidden Gems), CATEGORIES grid (All, Sport, Dining, Music, Gallery, Outdoor, Nightlife, Wellness), TRENDING NOW activity cards, SAVED SHORTCUTS section, and Open Map button at the bottom."}, {"id": "designupload_explore_filters", "label": "Explore Filter Links (For You, Trending, This Weekend, New & Notable, Hidden Gems)", "file_type": "image", "source_file": "wandr_design/uploads/3F4BD718-3F2D-4350-A03F-3EFE84EA512E.png", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "EXPLORE sub-section in the sidebar listing quick filter options: For You (active), Trending Now, This Weekend, New & Notable, Hidden Gems."}, {"id": "designupload_categories_grid", "label": "Categories Grid (All, Sport, Dining, Music, Gallery, Outdoor, Nightlife, Wellness)", "file_type": "image", "source_file": "wandr_design/uploads/3F4BD718-3F2D-4350-A03F-3EFE84EA512E.png", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "CATEGORIES section in the sidebar with icon+label tiles: All (active, dark pill), Sport, Dining, Music, Gallery, Outdoor, Nightlife, Wellness. Maps to preset/filter system."}, {"id": "designupload_sidebar_trending_now", "label": "Sidebar Trending Now Activity Cards", "file_type": "image", "source_file": "wandr_design/uploads/3F4BD718-3F2D-4350-A03F-3EFE84EA512E.png", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Compact activity cards in the sidebar TRENDING NOW section, showing thumbnail + title + star rating for items like F1 Canadian Grand Prix, Rooftop Fridays, Canadiens Playoff Rush."}, {"id": "designupload_saved_shortcuts", "label": "Saved Shortcuts Section", "file_type": "image", "source_file": "wandr_design/uploads/3F4BD718-3F2D-4350-A03F-3EFE84EA512E.png", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "SAVED SHORTCUTS section in sidebar with items like 'Zone Night Ideas', 'Weekend with Friends', 'Outdoor Adventures'."}, {"id": "designupload_open_map_button", "label": "Open Map Button", "file_type": "image", "source_file": "wandr_design/uploads/3F4BD718-3F2D-4350-A03F-3EFE84EA512E.png", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Blue 'Open Map' button at the bottom of the left sidebar, providing direct access to the map view."}, {"id": "designupload_hero_banner", "label": "Featured This Week Hero Banner \u2014 Formula 1 Canadian Grand Prix", "file_type": "image", "source_file": "wandr_design/uploads/3F4BD718-3F2D-4350-A03F-3EFE84EA512E.png", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Large carousel hero banner at the top of the main content area. Shows a dramatic F1 car image with Montreal skyline, headline 'Formula 1 Canadian Grand Prix', tagline 'The city. The speed. The energy.', and an orange 'Explore Now' CTA button. Carousel dots visible at bottom."}, {"id": "designupload_hero_featured_label", "label": "Featured This Week Label", "file_type": "image", "source_file": "wandr_design/uploads/3F4BD718-3F2D-4350-A03F-3EFE84EA512E.png", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "'FEATURED THIS WEEK' label at top of hero banner \u2014 editorial curation label."}, {"id": "designupload_hero_cta_button", "label": "Explore Now CTA Button", "file_type": "image", "source_file": "wandr_design/uploads/3F4BD718-3F2D-4350-A03F-3EFE84EA512E.png", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Orange 'Explore Now' button inside the hero banner \u2014 primary call-to-action for the featured activity."}, {"id": "designupload_right_activity_cards_column", "label": "Right Column Activity Cards (beside hero)", "file_type": "image", "source_file": "wandr_design/uploads/3F4BD718-3F2D-4350-A03F-3EFE84EA512E.png", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Three stacked compact activity cards to the right of the hero banner: 'Canadiens Playoff Rush' (5 stars), 'Rooftop Fridays Old Montreal' (5 stars), 'Jazz Night Le Balcon' (5 stars). Each has a thumbnail and star rating."}, {"id": "designupload_explore_near_you_section", "label": "Explore Near You \u2014 Map Section", "file_type": "image", "source_file": "wandr_design/uploads/3F4BD718-3F2D-4350-A03F-3EFE84EA512E.png", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Section titled 'Explore Near You' with subtitle 'Handpicked activities around Montreal'. Contains an interactive map of Montreal with activity pins, zoom controls, and a 'See all' link. Map shows location markers scattered across the city."}, {"id": "designupload_montreal_map", "label": "Montreal Interactive Map with Activity Pins", "file_type": "image", "source_file": "wandr_design/uploads/3F4BD718-3F2D-4350-A03F-3EFE84EA512E.png", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Map tile of Montreal with orange/colored pin markers indicating activity locations. Includes zoom controls (+/-). City name 'Montreal' visible on map."}, {"id": "designupload_from_the_map_section", "label": "From the Map \u2014 Horizontal Activity Card Scroll", "file_type": "image", "source_file": "wandr_design/uploads/3F4BD718-3F2D-4350-A03F-3EFE84EA512E.png", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Section titled 'From the Map' with 'See what's around you' subtitle. Horizontal scrollable row of activity cards: Terrasse Nelligan, Fadel District, Lafontaine Parc from Plus, Satay Brothers. Each card has image, title, distance/rating."}, {"id": "designupload_from_map_activity_card", "label": "From the Map Activity Card (Terrasse Nelligan, Fadel District, Lafontaine, Satay Brothers)", "file_type": "image", "source_file": "wandr_design/uploads/3F4BD718-3F2D-4350-A03F-3EFE84EA512E.png", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Compact cards in the From the Map row: photo thumbnail, activity name, distance (e.g. 1.5 km - 2.1 km), star ratings. Represents geo-proximate activity discovery."}, {"id": "designupload_recommended_for_you_section", "label": "Recommended for You \u2014 Activity Cards Grid", "file_type": "image", "source_file": "wandr_design/uploads/3F4BD718-3F2D-4350-A03F-3EFE84EA512E.png", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Section titled 'Recommended for You' with subtitle 'Curated picks based on your vibe'. Contains filter tabs (All, Popular, This Weekend, Near You, Sort) and a horizontal scrollable row of large activity cards."}, {"id": "designupload_recommended_filter_tabs", "label": "Recommended Filter Tabs (All, Popular, This Weekend, Near You, Sort)", "file_type": "image", "source_file": "wandr_design/uploads/3F4BD718-3F2D-4350-A03F-3EFE84EA512E.png", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Pill-style filter tabs above the recommended cards: All (active, dark), Popular, This Weekend, Near You, Sort. These filter/sort the curated feed."}, {"id": "designupload_recommended_activity_cards", "label": "Recommended Activity Cards (Canadiens vs Rangers, Rooftop Fridays, Jazz Night Le Balcon, Clip n Climb)", "file_type": "image", "source_file": "wandr_design/uploads/3F4BD718-3F2D-4350-A03F-3EFE84EA512E.png", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Large activity cards in the Recommended section. Each card has: category badge (orange pill e.g. 'Tonight'), activity image, title, date/time, price (e.g. $89+, $25+, $30+, $22+), distance, 'View on Map' link, and a bookmark/favorite icon. Cards visible: Canadiens vs Rangers, Rooftop Fridays Old Montreal, Jazz Night at Le Balcon, Clip n Climb Montreal."}, {"id": "designupload_activity_card_price_badge", "label": "Activity Card Price Badge", "file_type": "image", "source_file": "wandr_design/uploads/3F4BD718-3F2D-4350-A03F-3EFE84EA512E.png", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Price labels on activity cards (e.g. $89+, $25+, $30+, $22+) \u2014 pricing information display component."}, {"id": "designupload_view_on_map_link", "label": "View on Map Link on Activity Cards", "file_type": "image", "source_file": "wandr_design/uploads/3F4BD718-3F2D-4350-A03F-3EFE84EA512E.png", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "'View on Map' text link with map icon on each recommended activity card \u2014 bridges from activity feed to map view."}, {"id": "designupload_activity_category_badge", "label": "Activity Category/Time Badge (orange pill \u2014 Tonight, Outdoor, etc.)", "file_type": "image", "source_file": "wandr_design/uploads/3F4BD718-3F2D-4350-A03F-3EFE84EA512E.png", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Orange pill badges on activity cards indicating category or timing (e.g. 'Tonight', 'Outdoor'). Consistent visual labeling across all card types."}, {"id": "designupload_bottom_cta_strip", "label": "Bottom CTA Strip \u2014 Make Every Day an Adventure", "file_type": "image", "source_file": "wandr_design/uploads/3F4BD718-3F2D-4350-A03F-3EFE84EA512E.png", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Full-width bottom strip with headline 'Make every day an adventure.', subtitle 'Discover places to match your mood, your people, your city.' and a 'Let's Explore' orange CTA button. Dark background with a city skyline silhouette graphic."}, {"id": "designupload_lets_explore_button", "label": "Let's Explore CTA Button", "file_type": "image", "source_file": "wandr_design/uploads/3F4BD718-3F2D-4350-A03F-3EFE84EA512E.png", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Orange 'Let's Explore' button in the bottom CTA strip \u2014 re-engagement / onboarding call-to-action."}, {"id": "designupload_home_preset", "label": "Home Preset (page configuration)", "file_type": "rationale", "source_file": "wandr_design/uploads/3F4BD718-3F2D-4350-A03F-3EFE84EA512E.png", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The HOME_PRESET that parameterizes the home page composition \u2014 governs which sections, filters, and curated content appear on the default landing page."}, {"id": "designupload_activity_card_component", "label": "ActivityCard Component (production)", "file_type": "rationale", "source_file": "wandr_design/uploads/3F4BD718-3F2D-4350-A03F-3EFE84EA512E.png", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The production ActivityCard UI component in modules/activities/web/ \u2014 renders title, image, price, distance, category badge, and map link."}, {"id": "designupload_feed_module", "label": "Feed Module (modules/feed)", "file_type": "rationale", "source_file": "wandr_design/uploads/3F4BD718-3F2D-4350-A03F-3EFE84EA512E.png", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The feed capability module that drives the Recommended for You and From the Map sections \u2014 curated, filtered, ranked activity lists."}, {"id": "designupload_map_module", "label": "Map Module / Mapbox Adapter", "file_type": "rationale", "source_file": "wandr_design/uploads/3F4BD718-3F2D-4350-A03F-3EFE84EA512E.png", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Map rendering capability (Mapbox adapter in infra) that powers the Explore Near You map and activity pin markers."}, {"id": "designupload_nav_component", "label": "Nav Component (shared/ui Nav)", "file_type": "rationale", "source_file": "wandr_design/uploads/3F4BD718-3F2D-4350-A03F-3EFE84EA512E.png", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The shared Nav component providing the top navigation bar across all pages \u2014 logo, search, page links, profile avatar."}], "edges": [{"source": "designupload_wandr_home_desktop_mockup", "target": "designupload_top_navigation_bar", "relation": "conceptually_related_to", "confidence": "INFERRED", "confidence_score": 0.95, "source_file": "wandr_design/uploads/3F4BD718-3F2D-4350-A03F-3EFE84EA512E.png", "source_loca