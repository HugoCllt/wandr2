    "@prisma/client": "^5.22.0",
    "@radix-ui/react-checkbox": "^1.3.3",
    "@radix-ui/react-popover": "^1.1.15",
    "better-auth": "1.6.11",
    "lenis": "^1.3.23",
    "maplibre-gl": "^5.24.0",
    "next": "^14.2.18",
    "pino": "^9.5.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-map-gl": "^8.1.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@better-auth/cli": "1.4.21",
    "@eslint/eslintrc": "^3.1.0",
    "@types/node": "^20.17.6",
