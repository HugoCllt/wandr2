    "@typescript-eslint/eslint-plugin": "^8.14.0",
    "@typescript-eslint/parser": "^8.14.0",
    "dependency-cruiser": "^16.5.0",
    "eslint": "^8.57.1",
    "eslint-config-next": "^14.2.18",
    "fast-check": "^4.7.0",
    "prettier": "^3.3.3",
    "prisma": "^5.22.0",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vitest": "^2.1.9"
  },
  "packageManager": "pnpm@11.4.0"
